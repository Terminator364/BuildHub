{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pc.command.event.v1",
  "title": "PC Command Event",
  "type": "object",
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "time",
    "conversation_id",
    "sequence",
    "summary"
  ],
  "properties": {
    "specversion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "subject": {
      "type": [
        "string",
        "null"
      ]
    },
    "conversation_id": {
      "type": "string",
      "minLength": 1
    },
    "trace_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "span_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "parent_span_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "macro_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "micro_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "state": {
      "type": [
        "string",
        "null"
      ]
    },
    "completion": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "evidence_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "payload_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "payload_bytes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    }
  },
  "additionalProperties": true
}