    "nonblocking_state_sync": true,
    "input_first_loop": true
  },
  "event_bus": {
    "enabled": false,
    "mode": "dormant_experimental",
    "reason": "disabled in local runtime to preserve instant UI and low RAM"
  },
  "navigation": {
    "cache_first": true,
    "max_visual_response_ms": 500,
    "network_refresh_after_navigation": true,
    "local_state_only_on_keypress": true
