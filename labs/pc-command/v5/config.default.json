    "max_events_loaded": 100,
    "ram_budget_mb": 150,
    "history_max_bytes": 524288
  },
  "drive": {
    "root_folder_id": "1fFLEoZxzoAkrMzC9SxjvOlzbTsW1ZjLW",
    "reports_folder_id": "1Y6tgwMBHYaQPvsWIWCvEdUrUOgP681a3",
    "checkpoints_folder_id": "1zLolAtOMPtoLkr8OxCEk5FJkNncBbSfN",
    "exports_folder_id": "1WttL-Nm4DbpFjnGizDUY5YN-lWYQw9zA"
  },
  "privacy": {
    "no_passwords": true,
    "no_chain_of_thought": true,
    "observable_state_only": true
  },
